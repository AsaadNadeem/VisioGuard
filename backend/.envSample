# Copy this file to `.env` and fill values before running the backend.

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/mydb?retryWrites=true&w=majority

# Server port
PORT=5000

# Cloudinary credentials (used by backend only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Sightengine moderation API credentials
SIGHTENGINE_USER=your_sightengine_user
SIGHTENGINE_SECRET=your_sightengine_secret

# Optional: development/production
NODE_ENV=development
